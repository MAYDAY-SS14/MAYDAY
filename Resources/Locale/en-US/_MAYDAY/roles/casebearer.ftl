roles-antag-casebearer-name = Casebearer
roles-antag-casebearer-objective = Carry a secure weapon case. Turn it over to whomever you see fit. Keep it safe, keep it secret.

role-subtype-casebearer = Casebearer

casebearer-role-greeting =
    You have been selected to carry a secure weapon case onto the station.
    The case is locked and can only be properly opened by a member of Command.
    Spies and saboteurs hide behind every shadow. Only deliver the case to somebody you can trust.

casebearer-briefing =
    You are the secret holder of a secure weapon case.
    You have been asked to provide it to a member of Command at your discretion.

# casebearers have no distinct objective
# objective-issuer-casebearer = [color=#FA2A55]The Syndicate[/color]

casebearer-round-end-agent-name = casebearer
